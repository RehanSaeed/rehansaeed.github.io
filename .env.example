# Optional GA4 measurement ID. Leave empty to disable analytics locally.
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Optional server-only GA4 reporting. Set all three to enable article charts.
# Numeric property ID (not the public G- measurement ID).
GA4_PROPERTY_ID=
# First date with reliable tracking, YYYY-MM-DD; unavailable history is not zero.
GA4_START_DATE=
# Service-account JSON with Viewer access to the property. Never use NUXT_PUBLIC_.
GA4_SERVICE_ACCOUNT_JSON=
