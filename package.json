{
  "name": "rehansaeed.com",
  "version": "1.0.0",
  "description": "Muhammad Rehan Saeed's Blog",
  "author": "Muhammad Rehan Saeed",
  "homepage": "https://rehansaeed.com",
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "Muhammad",
    "Rehan",
    "Saeed",
    "Blog",
    "Website"
  ],
  "bugs": {
    "url": "https://github.com/RehanSaeed/rehansaeed.github.io/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RehanSaeed/rehansaeed.github.io.git"
  },
  "dependencies": {
    "@floating-ui/vue": "2.0.1",
    "@fontsource-variable/cascadia-code": "5.3.0",
    "@fontsource/audiowide": "5.3.0",
    "@nuxt/content": "3.16.2",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxt/scripts": "2.0.0-beta.16",
    "@nuxtjs/seo": "6.0.1",
    "@nuxtjs/sitemap": "9.1.0",
    "@sindresorhus/slugify": "3.0.1",
    "@vite-pwa/nuxt": "1.1.1",
    "date-fns": "4.4.0",
    "feed": "6.0.0",
    "flexsearch": "0.8.212",
    "katex": "0.19.1",
    "mermaid": "12.2.0",
    "nuxt": "4.6.3",
    "nuxt-og-image": "7.0.7",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sanitize-html": "2.18.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/fa-brands": "1.2.2",
    "@iconify-json/fa-regular": "1.2.2",
    "@iconify-json/fa-solid": "1.2.2",
    "@iconify-json/feather": "1.2.1",
    "@iconify-json/lucide": "1.2.149",
    "@iconify-json/simple-icons": "1.2.101",
    "@lhci/cli": "0.15.1",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "1.2.0",
    "@playwright/test": "^1.64.1",
    "@takumi-rs/core": "2.19.0",
    "@types/sanitize-html": "2.16.2",
    "cheerio": "^1.2.0",
    "eslint": "10.13.0",
    "github-slugger": "2.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "marked": "18.1.2",
    "mdast-util-from-markdown": "2.1.0",
    "nuxt-link-checker": "6.0.1",
    "prettier": "3.9.10",
    "remark-toc": "9.0.0",
    "sass-embedded": "1.107.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "unist-util-visit": "5.2.0",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "scripts": {
    "images:avif": "node scripts/avif-images.mjs",
    "dev": "nuxt dev",
    "build": "nuxt generate && node scripts/pages.mjs artifact && npm run seo:verify",
    "start": "node scripts/serve.mjs",
    "analyze": "nuxt analyze",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test": "playwright test --project=chrome --project=edge --project=firefox",
    "test:debug": "playwright test --ui",
    "test:chrome": "playwright test --project=chrome",
    "test:edge": "playwright test --project=edge",
    "test:firefox": "playwright test --project=firefox",
    "test:visual": "playwright test --project=visual",
    "lighthouse": "lhci autorun",
    "pwa:screenshots": "node scripts/pwa-screenshots.mjs",
    "parity:snapshot": "node scripts/parity/snapshot.mjs",
    "parity:diff": "node scripts/parity/diff.mjs tests/parity/baseline .parity/local",
    "parity:verify": "node scripts/parity/verify.mjs",
    "parity:sw-cutover": "node scripts/parity/sw-cutover.mjs",
    "parity:update-cycle": "node scripts/parity/update-cycle.mjs",
    "seo:verify": "node scripts/seo.mjs",
    "og:gallery": "node scripts/og-images.mjs",
    "pages:preflight": "node scripts/pages.mjs preflight",
    "pages:verify": "node scripts/pages.mjs verify"
  },
  "browserslist": [
    "defaults"
  ],
  "prettier": {
    "bracketSameLine": true,
    "endOfLine": "auto"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,scss,sass,md}": "prettier --write"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
